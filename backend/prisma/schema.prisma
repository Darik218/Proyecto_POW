generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserRole {
  ATHLETE
  ADMIN
}

enum MeasurementUnit {
  KG
  LB
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OneRmFormula {
  EPLEY
  BRZYCKI
}

enum EvidenceRole {
  SATISFACTORY
  UNSATISFACTORY
  CONTEXT
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  BLOCKED
  EXPIRED
}

enum ApplicationOrigin {
  MANUAL
  AUTOMATIC
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(320)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       AccountStatus @default(ACTIVE)
  role         UserRole      @default(ATHLETE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  athlete      Athlete?
  sessions     AuthSession[]

  @@map("users")
}

model Athlete {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  birthDate         DateTime?          @map("birth_date") @db.Date
  preferredUnit     MeasurementUnit    @default(KG) @map("preferred_unit")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  measurements      BodyMeasurement[]
  plans             TrainingPlan[]
  workoutSessions   WorkoutSession[]
  estimates         OneRmEstimate[]
  progressionSettings ProgressionSetting[]
  recommendations   ProgressionRecommendation[]

  @@map("athletes")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenFamilyId     String    @map("token_family_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt  DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  generation        Int       @default(0)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  consumedTokens    AuthSessionToken[]

  @@index([userId, expiresAt])
  @@index([tokenFamilyId, revokedAt])
  @@map("auth_sessions")
}

model AuthSessionToken {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @map("session_id") @db.Uuid
  tokenHash  String      @unique @map("token_hash") @db.Char(64)
  generation Int
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt DateTime    @map("consumed_at") @db.Timestamptz(6)
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, generation])
  @@map("auth_session_tokens")
}

model BodyMeasurement {
  id          String   @id @default(uuid()) @db.Uuid
  athleteId   String   @map("athlete_id") @db.Uuid
  bodyWeight  Decimal  @map("body_weight") @db.Decimal(7, 3)
  measuredAt  DateTime @map("measured_at") @db.Timestamptz(6)
  notes       String?  @db.Text
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([athleteId, measuredAt])
  @@map("body_measurements")
}

model Exercise {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(160)
  muscleGroup     String           @map("muscle_group") @db.VarChar(100)
  equipment       String           @db.VarChar(100)
  description     String?          @db.Text
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  planExercises   PlanExercise[]
  workoutExercises WorkoutExercise[]
  estimates       OneRmEstimate[]
  settings        ProgressionSetting[]
  recommendations ProgressionRecommendation[]

  @@index([name])
  @@index([muscleGroup, isActive])
  @@map("exercises")
}

model TrainingPlan {
  id                 String             @id @default(uuid()) @db.Uuid
  athleteId          String             @map("athlete_id") @db.Uuid
  name               String             @db.VarChar(160)
  startsOn           DateTime           @map("starts_on") @db.Date
  endsOn             DateTime?          @map("ends_on") @db.Date
  status             PlanStatus         @default(DRAFT)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  athlete            Athlete            @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  weeks              PlanWeek[]
  workoutSessions    WorkoutSession[]
  progressionSettings ProgressionSetting[]

  @@unique([id, athleteId])
  @@index([athleteId, status, startsOn])
  @@map("training_plans")
}

model PlanWeek {
  id                String             @id @default(uuid()) @db.Uuid
  trainingPlanId    String             @map("training_plan_id") @db.Uuid
  weekNumber        Int                @map("week_number")
  objective         String?            @db.Text
  trainingPlan      TrainingPlan       @relation(fields: [trainingPlanId], references: [id], onDelete: Restrict)
  planExercises     PlanExercise[]
  workoutSessions   WorkoutSession[]
  recommendations   ProgressionRecommendation[]

  @@unique([trainingPlanId, weekNumber])
  @@unique([id, trainingPlanId])
  @@index([trainingPlanId])
  @@map("plan_weeks")
}

model PlanExercise {
  id              String          @id @default(uuid()) @db.Uuid
  planWeekId      String          @map("plan_week_id") @db.Uuid
  exerciseId      String          @map("exercise_id") @db.Uuid
  position        Int
  targetSets      Int             @map("target_sets")
  targetReps      Int             @map("target_reps")
  targetRpe       Decimal?        @map("target_rpe") @db.Decimal(3, 1)
  targetLoad      Decimal?        @map("target_load") @db.Decimal(8, 3)
  notes           String?         @db.Text
  planWeek        PlanWeek        @relation(fields: [planWeekId], references: [id], onDelete: Restrict)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutExercises WorkoutExercise[]
  recommendations ProgressionRecommendation[]

  @@unique([planWeekId, position])
  @@unique([id, exerciseId])
  @@index([exerciseId])
  @@map("plan_exercises")
}

model WorkoutSession {
  id              String          @id @default(uuid()) @db.Uuid
  athleteId       String          @map("athlete_id") @db.Uuid
  trainingPlanId  String?         @map("training_plan_id") @db.Uuid
  planWeekId      String?         @map("plan_week_id") @db.Uuid
  status          WorkoutStatus   @default(PLANNED)
  startedAt       DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?       @map("finished_at") @db.Timestamptz(6)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  athlete         Athlete         @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  trainingPlan    TrainingPlan?   @relation(fields: [trainingPlanId, athleteId], references: [id, athleteId], onDelete: Restrict)
  planWeek        PlanWeek?       @relation(fields: [planWeekId, trainingPlanId], references: [id, trainingPlanId], onDelete: Restrict)
  exercises       WorkoutExercise[]
  feedback        SessionFeedback?
  evidence        RecommendationEvidence[]

  @@index([athleteId, startedAt, status])
  @@index([trainingPlanId, planWeekId])
  @@map("workout_sessions")
}

model WorkoutExercise {
  id             String        @id @default(uuid()) @db.Uuid
  sessionId      String        @map("session_id") @db.Uuid
  exerciseId     String        @map("exercise_id") @db.Uuid
  planExerciseId String?       @map("plan_exercise_id") @db.Uuid
  orderInSession Int           @map("order_in_session")
  notes          String?       @db.Text
  session        WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  exercise       Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  planExercise   PlanExercise? @relation(fields: [planExerciseId, exerciseId], references: [id, exerciseId], onDelete: Restrict)
  sets           SetRecord[]

  @@unique([sessionId, orderInSession])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model SetRecord {
  id                String         @id @default(uuid()) @db.Uuid
  workoutExerciseId String         @map("workout_exercise_id") @db.Uuid
  setNumber         Int            @map("set_number")
  load              Decimal        @db.Decimal(8, 3)
  repetitions       Int
  rpe               Decimal?       @db.Decimal(3, 1)
  isCompleted       Boolean        @default(true) @map("is_completed")
  recordedAt        DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)
  notes             String?        @db.Text
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Restrict)
  estimates         OneRmEstimate[]

  @@unique([workoutExerciseId, setNumber])
  @@index([recordedAt])
  @@map("set_records")
}

model OneRmEstimate {
  id             String         @id @default(uuid()) @db.Uuid
  athleteId      String         @map("athlete_id") @db.Uuid
  exerciseId     String         @map("exercise_id") @db.Uuid
  sourceSetId    String?        @map("source_set_id") @db.Uuid
  inputLoad      Decimal        @map("input_load") @db.Decimal(8, 3)
  inputReps      Int            @map("input_reps")
  estimatedOneRm Decimal        @map("estimated_one_rm") @db.Decimal(8, 3)
  formula        OneRmFormula
  algorithmVersion String       @map("algorithm_version") @db.VarChar(40)
  calculatedAt   DateTime       @default(now()) @map("calculated_at") @db.Timestamptz(6)
  athlete        Athlete        @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sourceSet      SetRecord?     @relation(fields: [sourceSetId], references: [id], onDelete: Restrict)

  @@index([athleteId, exerciseId, calculatedAt])
  @@index([sourceSetId])
  @@map("one_rm_estimates")
}

model SessionFeedback {
  id          String         @id @default(uuid()) @db.Uuid
  sessionId   String         @unique @map("session_id") @db.Uuid
  globalRpe   Decimal?       @map("global_rpe") @db.Decimal(3, 1)
  fatigueScore Decimal?      @map("fatigue_score") @db.Decimal(5, 2)
  notes       String?        @db.Text
  recordedAt  DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([recordedAt])
  @@map("session_feedback")
}

model ProgressionSetting {
  id                  String        @id @default(uuid()) @db.Uuid
  athleteId           String        @map("athlete_id") @db.Uuid
  exerciseId          String?       @map("exercise_id") @db.Uuid
  trainingPlanId      String?       @map("training_plan_id") @db.Uuid
  minSuccessfulSessions Int         @default(3) @map("min_successful_sessions")
  targetRpeMin        Decimal       @map("target_rpe_min") @db.Decimal(3, 1)
  targetRpeMax        Decimal       @map("target_rpe_max") @db.Decimal(3, 1)
  incrementPercent    Decimal?      @map("increment_percent") @db.Decimal(6, 3)
  incrementAbsolute   Decimal?      @map("increment_absolute") @db.Decimal(8, 3)
  maxIncrementPercent Decimal       @map("max_increment_percent") @db.Decimal(6, 3)
  maxLoad             Decimal?      @map("max_load") @db.Decimal(8, 3)
  autoApplyAuthorized Boolean       @default(false) @map("auto_apply_authorized")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  athlete             Athlete       @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  exercise            Exercise?     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  trainingPlan        TrainingPlan? @relation(fields: [trainingPlanId, athleteId], references: [id, athleteId], onDelete: Restrict)

  @@index([athleteId, exerciseId, trainingPlanId])
  @@map("progression_settings")
}

model ProgressionRecommendation {
  id               String             @id @default(uuid()) @db.Uuid
  athleteId        String             @map("athlete_id") @db.Uuid
  exerciseId       String             @map("exercise_id") @db.Uuid
  planWeekId       String?            @map("plan_week_id") @db.Uuid
  planExerciseId   String?            @map("plan_exercise_id") @db.Uuid
  previousLoad     Decimal?           @map("previous_load") @db.Decimal(8, 3)
  recommendedLoad  Decimal            @map("recommended_load") @db.Decimal(8, 3)
  justification    String             @db.Text
  status           RecommendationStatus @default(PENDING)
  algorithmVersion String             @map("algorithm_version") @db.VarChar(40)
  effectiveSettings Json              @map("effective_settings") @db.JsonB
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz(6)
  reviewedAt       DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  athlete          Athlete            @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  exercise         Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  planWeek         PlanWeek?          @relation(fields: [planWeekId], references: [id], onDelete: Restrict)
  planExercise     PlanExercise?      @relation(fields: [planExerciseId, exerciseId], references: [id, exerciseId], onDelete: Restrict)
  evidence         RecommendationEvidence[]
  application      ProgressionApplication?

  @@index([athleteId, status, createdAt])
  @@index([exerciseId, createdAt])
  @@index([planWeekId])
  @@map("progression_recommendations")
}

model RecommendationEvidence {
  id                String                  @id @default(uuid()) @db.Uuid
  recommendationId String                  @map("recommendation_id") @db.Uuid
  sessionId         String                  @map("session_id") @db.Uuid
  role              EvidenceRole
  associatedAt      DateTime                @default(now()) @map("associated_at") @db.Timestamptz(6)
  recommendation   ProgressionRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  session          WorkoutSession           @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([recommendationId, sessionId])
  @@index([sessionId])
  @@map("recommendation_evidence")
}

model ProgressionApplication {
  id               String                 @id @default(uuid()) @db.Uuid
  recommendationId String                 @unique @map("recommendation_id") @db.Uuid
  appliedLoad      Decimal                @map("applied_load") @db.Decimal(8, 3)
  origin           ApplicationOrigin
  effectiveAt      DateTime               @map("effective_at") @db.Timestamptz(6)
  recommendation   ProgressionRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)

  @@index([effectiveAt])
  @@map("progression_applications")
}
