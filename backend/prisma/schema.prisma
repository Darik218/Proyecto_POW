generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserRole {
  ATHLETE
  ADMIN
}

enum MeasurementUnit {
  KG
  LB
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum WorkoutSetStatus {
  PENDING
  COMPLETED
  INCOMPLETE
  FAILED
  SKIPPED
}

enum WorkoutSetKind {
  WARMUP
  WORK
}

enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OneRmFormula {
  EPLEY
  BRZYCKI
}

enum EvidenceRole {
  SATISFACTORY
  UNSATISFACTORY
  CONTEXT
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  BLOCKED
  EXPIRED
}

enum ApplicationOrigin {
  MANUAL
  AUTOMATIC
}

enum ExerciseOrigin {
  GLOBAL
  PERSONAL
}

enum ExerciseEquipmentType {
  BARBELL
  EZ_BAR
  DUMBBELL
  MACHINE
  SMITH_MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  RESISTANCE_BAND
  MEDICINE_BALL
  RINGS
  LANDMINE
  OTHER
}

enum ExerciseMachineType {
  SELECTORIZED
  PLATE_LOADED
  CONVERGING
  SMITH
  CABLE
  LEVER
  HACK_SQUAT
  LEG_PRESS
  OTHER
}

enum ExerciseResistanceType {
  FREE_WEIGHT
  BODYWEIGHT
  WEIGHT_STACK
  PLATE_LOADED
  CABLE
  ELASTIC
  MEDICINE_BALL
  ISOMETRIC
  OTHER
}

enum ExerciseMovementType {
  COMPOUND
  ISOLATION
  OLYMPIC
  PLYOMETRIC
  ISOMETRIC
  CARRY
  MOBILITY
}

enum ExerciseMovementPattern {
  SQUAT
  HIP_HINGE
  LUNGE
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  ELBOW_FLEXION
  ELBOW_EXTENSION
  SHOULDER_ABDUCTION
  SHOULDER_ROTATION
  HIP_EXTENSION
  HIP_ABDUCTION
  HIP_ADDUCTION
  KNEE_EXTENSION
  KNEE_FLEXION
  CALF_RAISE
  TRUNK_FLEXION
  TRUNK_EXTENSION
  ROTATION
  ANTI_ROTATION
  CARRY
  OLYMPIC_LIFT
  JUMP
  OTHER
}

enum ExerciseGrip {
  PRONATED
  SUPINATED
  NEUTRAL
  MIXED
  HOOK
  STRAPPED
  NONE
  VARIABLE
}

enum ExerciseGripWidth {
  NARROW
  SHOULDER_WIDTH
  WIDE
  VARIABLE
  NOT_APPLICABLE
}

enum ExerciseBodyPosition {
  STANDING
  SEATED
  SUPINE
  PRONE
  SIDE_LYING
  KNEELING
  HALF_KNEELING
  HANGING
  QUADRUPED
  OTHER
}

enum ExerciseLaterality {
  UNILATERAL
  BILATERAL
  ALTERNATING
  NOT_APPLICABLE
}

enum ExerciseMovementPlane {
  SAGITTAL
  FRONTAL
  TRANSVERSE
  MULTIPLANAR
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum OneRmSuitability {
  SUITABLE
  NOT_SUITABLE
  UNDETERMINED
}

model User {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique @db.VarChar(320)
  passwordHash     String        @map("password_hash") @db.VarChar(255)
  status           AccountStatus @default(ACTIVE)
  role             UserRole      @default(ATHLETE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  athlete          Athlete?
  sessions         AuthSession[]
  createdExercises Exercise[]

  @@map("users")
}

model Athlete {
  id                  String                      @id @default(uuid()) @db.Uuid
  userId              String                      @unique @map("user_id") @db.Uuid
  birthDate           DateTime?                   @map("birth_date") @db.Date
  preferredUnit       MeasurementUnit             @default(KG) @map("preferred_unit")
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  measurements        BodyMeasurement[]
  plans               TrainingPlan[]
  workoutSessions     WorkoutSession[]
  estimates           OneRmEstimate[]
  progressionSettings ProgressionSetting[]
  recommendations     ProgressionRecommendation[]
  activities ScheduledActivity[]
  planningOperations PlanningOperation[]

  @@map("athletes")
}

model AuthSession {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  tokenFamilyId     String             @map("token_family_id") @db.Uuid
  refreshTokenHash  String             @unique @map("refresh_token_hash") @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime           @map("absolute_expires_at") @db.Timestamptz(6)
  lastUsedAt        DateTime           @default(now()) @map("last_used_at") @db.Timestamptz(6)
  generation        Int                @default(0)
  revokedAt         DateTime?          @map("revoked_at") @db.Timestamptz(6)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  consumedTokens    AuthSessionToken[]

  @@index([userId, expiresAt])
  @@index([tokenFamilyId, revokedAt])
  @@map("auth_sessions")
}

model AuthSessionToken {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @map("session_id") @db.Uuid
  tokenHash  String      @unique @map("token_hash") @db.Char(64)
  generation Int
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt DateTime    @map("consumed_at") @db.Timestamptz(6)
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, generation])
  @@map("auth_session_tokens")
}

model BodyMeasurement {
  id         String   @id @default(uuid()) @db.Uuid
  athleteId  String   @map("athlete_id") @db.Uuid
  bodyWeight Decimal  @map("body_weight") @db.Decimal(7, 3)
  measuredAt DateTime @map("measured_at") @db.Timestamptz(6)
  notes      String?  @db.Text
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([athleteId, measuredAt])
  @@map("body_measurements")
}

model MuscleGroup {
  id                 String                         @id @default(uuid()) @db.Uuid
  key                String                         @unique @db.VarChar(100)
  name               String                         @unique @db.VarChar(100)
  description        String?                        @db.Text
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  primaryExercises   Exercise[]                     @relation("PrimaryExerciseMuscleGroup")
  secondaryExercises ExerciseSecondaryMuscleGroup[]

  @@map("muscle_groups")
}

model Exercise {
  searchName String @default("") @map("search_name") @db.Text
  searchDescription String @default("") @map("search_description") @db.Text
  featuredRank Int? @map("featured_rank")
  aliases ExerciseAlias[]
  id                    String                         @id @default(uuid()) @db.Uuid
  catalogKey            String?                        @unique @map("catalog_key") @db.VarChar(140)
  origin                ExerciseOrigin                 @default(GLOBAL)
  ownerId               String?                        @map("owner_id") @db.Uuid
  name                  String                         @db.VarChar(160)
  primaryMuscleGroupId  String                         @map("primary_muscle_group_id") @db.Uuid
  equipment             String                         @db.VarChar(100)
  equipmentType         ExerciseEquipmentType          @default(OTHER) @map("equipment_type")
  machineType           ExerciseMachineType?           @map("machine_type")
  resistanceType        ExerciseResistanceType?        @map("resistance_type")
  movementType          ExerciseMovementType?          @map("movement_type")
  movementPattern       ExerciseMovementPattern?       @map("movement_pattern")
  grip                  ExerciseGrip?
  gripWidth             ExerciseGripWidth?             @map("grip_width")
  bodyPosition          ExerciseBodyPosition?          @map("body_position")
  laterality            ExerciseLaterality?
  movementPlane         ExerciseMovementPlane?         @map("movement_plane")
  difficulty            ExerciseDifficulty?
  oneRmSuitability      OneRmSuitability               @default(UNDETERMINED) @map("one_rm_suitability")
  description           String?                        @db.Text
  instructions          String?                        @db.Text
  isActive              Boolean                        @default(true) @map("is_active")
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                 User?                          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  primaryMuscleGroup    MuscleGroup                    @relation("PrimaryExerciseMuscleGroup", fields: [primaryMuscleGroupId], references: [id], onDelete: Restrict)
  secondaryMuscleGroups ExerciseSecondaryMuscleGroup[]
  planExercises         PlanExercise[]
  workoutExercises      WorkoutExercise[]
  estimates             OneRmEstimate[]
  settings              ProgressionSetting[]
  recommendations       ProgressionRecommendation[]

  @@index([searchName(ops: raw("gin_trgm_ops"))],type:Gin,map:"exercises_search_name_gin")
  @@index([searchDescription(ops:raw("gin_trgm_ops"))],type:Gin,map:"exercises_search_description_gin")
  @@index([featuredRank],map:"exercises_featured_rank_idx")
  @@index([origin, isActive, name, id])
  @@index([ownerId, isActive, name, id])
  @@index([primaryMuscleGroupId, isActive])
  @@index([equipmentType, isActive])
  @@index([machineType, isActive])
  @@index([resistanceType, isActive])
  @@index([movementType, isActive])
  @@index([movementPattern, isActive])
  @@index([difficulty, isActive])
  @@map("exercises")
}

model ExerciseSecondaryMuscleGroup {
  exerciseId    String      @map("exercise_id") @db.Uuid
  muscleGroupId String      @map("muscle_group_id") @db.Uuid
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Restrict)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId, exerciseId])
  @@map("exercise_secondary_muscle_groups")
}

model TrainingPlan {
  id                  String               @id @default(uuid()) @db.Uuid
  athleteId           String               @map("athlete_id") @db.Uuid
  name                String               @db.VarChar(160)
  startsOn            DateTime?            @map("starts_on") @db.Date
  endsOn              DateTime?            @map("ends_on") @db.Date
  status              PlanStatus           @default(DRAFT)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  athlete             Athlete              @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  weeks               PlanWeek[]
  workoutSessions     WorkoutSession[]
  progressionSettings ProgressionSetting[]
  creationRequestHash String? @map("creation_request_hash") @db.Char(64)
  version Int @default(0)
  operations PlanningOperation[]

  @@unique([id, athleteId])
  @@index([athleteId, status, startsOn])
  @@map("training_plans")
}

model PlanWeek {
  id              String                      @id @default(uuid()) @db.Uuid
  trainingPlanId  String                      @map("training_plan_id") @db.Uuid
  weekNumber      Int                         @map("week_number")
  objective       String?                     @db.Text
  startsOn        DateTime?                   @map("starts_on") @db.Date
  trainingPlan    TrainingPlan                @relation(fields: [trainingPlanId], references: [id], onDelete: Restrict)
  planExercises   PlanExercise[]
  days            PlanDay[]
  activities ScheduledActivity[]
  workoutSessions WorkoutSession[]
  recommendations ProgressionRecommendation[]

  @@unique([trainingPlanId, weekNumber])
  @@unique([id, trainingPlanId])
  @@index([trainingPlanId])
  @@index([trainingPlanId, startsOn])
  @@map("plan_weeks")
}

model PlanDay {
  id                     String           @id @default(uuid()) @db.Uuid
  planWeekId             String           @map("plan_week_id") @db.Uuid
  name                   String           @db.VarChar(160)
  position               Int
  weekday                Int?
  planWeek               PlanWeek         @relation(fields: [planWeekId], references: [id], onDelete: Restrict)
  exercises              PlanExercise[]
  workoutSessions        WorkoutSession[] @relation("WorkoutPlanDay")
  retiredFromOn DateTime? @map("retired_from_on") @db.Date
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)
  isEditableOverride Boolean @default(false) @map("is_editable_override")
  activities ScheduledActivity[] @relation("CurrentActivityDay")
  originalActivities ScheduledActivity[] @relation("OriginalActivityDay")
  sourceWorkoutSessionId String?          @map("source_workout_session_id") @db.Uuid
  creationRequestHash    String?          @map("creation_request_hash") @db.Char(64)
  sourceWorkoutSession   WorkoutSession?  @relation("SavedWorkoutDay", fields: [sourceWorkoutSessionId], references: [id], onDelete: Restrict)

  @@index([planWeekId, retiredAt, position])
  @@unique([id, planWeekId])
  @@index([sourceWorkoutSessionId])
  @@map("plan_days")
}

model PlanExercise {
  id               String                      @id @default(uuid()) @db.Uuid
  planWeekId       String                      @map("plan_week_id") @db.Uuid
  exerciseId       String                      @map("exercise_id") @db.Uuid
  position         Int
  targetSets       Int                         @map("target_sets")
  targetReps       Int?                        @map("target_reps")
  targetRepsMin    Int?                        @map("target_reps_min")
  targetRepsMax    Int?                        @map("target_reps_max")
  targetLoadUnit   MeasurementUnit?            @map("target_load_unit")
  planDayId        String?                     @map("plan_day_id") @db.Uuid
  planDay          PlanDay?                    @relation(fields: [planDayId, planWeekId], references: [id, planWeekId], onDelete: Restrict)
  targetRpe        Decimal?                    @map("target_rpe") @db.Decimal(3, 1)
  targetLoad       Decimal?                    @map("target_load") @db.Decimal(8, 3)
  notes            String?                     @db.Text
  planWeek         PlanWeek                    @relation(fields: [planWeekId], references: [id], onDelete: Restrict)
  exercise         Exercise                    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutExercises WorkoutExercise[]
  recommendations  ProgressionRecommendation[]

  @@unique([planDayId, position])
  @@unique([id, exerciseId])
  @@index([planWeekId])
  @@index([exerciseId])
  @@map("plan_exercises")
}

model WorkoutSession {
  id                  String                   @id @default(uuid()) @db.Uuid
  athleteId           String                   @map("athlete_id") @db.Uuid
  trainingPlanId      String?                  @map("training_plan_id") @db.Uuid
  planWeekId          String?                  @map("plan_week_id") @db.Uuid
  planDayId           String?                  @map("plan_day_id") @db.Uuid
  performedOn         DateTime?                @map("performed_on") @db.Date
  timeZone            String?                  @map("time_zone") @db.VarChar(100)
  recordingMode       String?                  @map("recording_mode") @db.VarChar(20)
  name                String?                  @db.VarChar(160)
  creationRequestHash String?                  @map("creation_request_hash") @db.Char(64)
  version             Int                      @default(0)
  importOperations    Json?                    @map("import_operations") @db.JsonB
  scheduledActivityId String? @map("scheduled_activity_id") @db.Uuid
  scheduledActivity ScheduledActivity? @relation(fields: [scheduledActivityId, athleteId, planWeekId, planDayId], references: [id, athleteId, planWeekId, planDayId], onDelete: Restrict, map:"workout_sessions_scheduled_activity_id_athlete_id_fkey")
  sourceSnapshot      Json?                    @map("source_snapshot") @db.JsonB
  copiedFromSessionId String?                  @map("copied_from_session_id") @db.Uuid
  copiedFromSession   WorkoutSession?          @relation("RepeatedSession", fields: [copiedFromSessionId, athleteId], references: [id, athleteId], onDelete: Restrict)
  repeatedSessions    WorkoutSession[]         @relation("RepeatedSession")
  savedPlanDays       PlanDay[]                @relation("SavedWorkoutDay")
  completedAt         DateTime?                @map("completed_at") @db.Timestamptz(6)
  status              WorkoutStatus            @default(PLANNED)
  startedAt           DateTime?                @map("started_at") @db.Timestamptz(6)
  finishedAt          DateTime?                @map("finished_at") @db.Timestamptz(6)
  notes               String?                  @db.Text
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  athlete             Athlete                  @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  trainingPlan        TrainingPlan?            @relation(fields: [trainingPlanId, athleteId], references: [id, athleteId], onDelete: Restrict)
  planWeek            PlanWeek?                @relation(fields: [planWeekId, trainingPlanId], references: [id, trainingPlanId], onDelete: Restrict)
  planDay             PlanDay?                 @relation("WorkoutPlanDay", fields: [planDayId, planWeekId], references: [id, planWeekId], onDelete: Restrict)
  exercises           WorkoutExercise[]
  feedback            SessionFeedback?
  evidence            RecommendationEvidence[]

  @@unique([id, athleteId])
  @@index([copiedFromSessionId, athleteId])
  @@index([scheduledActivityId, athleteId])
  @@index([athleteId, performedOn, status])
  @@index([planDayId, planWeekId])
  @@index([athleteId, startedAt, status])
  @@index([trainingPlanId, planWeekId])
  @@map("workout_sessions")
}

model WorkoutExercise {
  id                        String            @id @default(uuid()) @db.Uuid
  sessionId                 String            @map("session_id") @db.Uuid
  exerciseId                String            @map("exercise_id") @db.Uuid
  planExerciseId            String?           @map("plan_exercise_id") @db.Uuid
  orderInSession            Int               @map("order_in_session")
  originalSnapshot          Json?             @map("original_snapshot") @db.JsonB
  creationRequestHash       String?           @map("creation_request_hash") @db.Char(64)
  isOmitted                 Boolean           @default(false) @map("is_omitted")
  targetSets                Int?              @map("target_sets")
  targetRepsMin             Int?              @map("target_reps_min")
  targetRepsMax             Int?              @map("target_reps_max")
  targetLoad                Decimal?          @map("target_load") @db.Decimal(8, 3)
  targetLoadUnit            MeasurementUnit?  @map("target_load_unit")
  targetRpe                 Decimal?          @map("target_rpe") @db.Decimal(3, 1)
  replacesWorkoutExerciseId String?           @map("replaces_workout_exercise_id") @db.Uuid
  replaces                  WorkoutExercise?  @relation("ExerciseReplacement", fields: [replacesWorkoutExerciseId, sessionId], references: [id, sessionId], onDelete: Restrict)
  replacements              WorkoutExercise[] @relation("ExerciseReplacement")
  notes                     String?           @db.Text
  session                   WorkoutSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  exercise                  Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  planExercise              PlanExercise?     @relation(fields: [planExerciseId, exerciseId], references: [id, exerciseId], onDelete: Restrict)
  sets                      SetRecord[]

  @@unique([id, sessionId])
  @@unique([sessionId, orderInSession])
  @@index([replacesWorkoutExerciseId, sessionId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model SetRecord {
  id                  String            @id @default(uuid()) @db.Uuid
  workoutExerciseId   String            @map("workout_exercise_id") @db.Uuid
  setNumber           Int               @map("set_number")
  load                Decimal?          @db.Decimal(8, 3)
  loadUnit            MeasurementUnit?  @map("load_unit")
  loadKg              Decimal?          @map("load_kg") @db.Decimal(12, 6)
  status              WorkoutSetStatus?
  kind                WorkoutSetKind?
  creationRequestHash String?           @map("creation_request_hash") @db.Char(64)
  version             Int               @default(0)
  repetitions         Int?
  rpe                 Decimal?          @db.Decimal(3, 1)
  isCompleted         Boolean           @default(true) @map("is_completed")
  recordedAt          DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(6)
  notes               String?           @db.Text
  workoutExercise     WorkoutExercise   @relation(fields: [workoutExerciseId], references: [id], onDelete: Restrict)
  estimates           OneRmEstimate[]

  @@unique([workoutExerciseId, setNumber])
  @@index([recordedAt])
  @@map("set_records")
}

model OneRmEstimate {
  id               String       @id @default(uuid()) @db.Uuid
  athleteId        String       @map("athlete_id") @db.Uuid
  exerciseId       String       @map("exercise_id") @db.Uuid
  sourceSetId      String?      @map("source_set_id") @db.Uuid
  inputLoad        Decimal      @map("input_load") @db.Decimal(8, 3)
  inputReps        Int          @map("input_reps")
  estimatedOneRm   Decimal      @map("estimated_one_rm") @db.Decimal(24, 6)
  formula          OneRmFormula
  algorithmVersion String       @map("algorithm_version") @db.VarChar(40)
  calculatedAt     DateTime     @default(now()) @map("calculated_at") @db.Timestamptz(6)
  inputLoadUnit    MeasurementUnit? @map("input_load_unit")
  inputLoadKg      Decimal?     @map("input_load_kg") @db.Decimal(24, 6)
  resultUnit       MeasurementUnit? @map("result_unit")
  sourceSetVersion Int?         @map("source_set_version")
  eligibilityVersion String?   @map("eligibility_version") @db.VarChar(40)
  estimateKind     String?      @map("estimate_kind") @db.VarChar(24)
  calculationKey   String?      @unique @map("calculation_key") @db.Char(64)
  snapshot         Json?        @db.JsonB
  athlete          Athlete      @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  exercise         Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sourceSet        SetRecord?   @relation(fields: [sourceSetId], references: [id], onDelete: Restrict)

  @@index([athleteId, exerciseId, calculatedAt])
  @@index([sourceSetId])
  @@map("one_rm_estimates")
}

model SessionFeedback {
  id           String         @id @default(uuid()) @db.Uuid
  sessionId    String         @unique @map("session_id") @db.Uuid
  globalRpe    Decimal?       @map("global_rpe") @db.Decimal(3, 1)
  fatigueScore Decimal?       @map("fatigue_score") @db.Decimal(5, 2)
  notes        String?        @db.Text
  recordedAt   DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)
  session      WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([recordedAt])
  @@map("session_feedback")
}

model ProgressionSetting {
  id                    String        @id @default(uuid()) @db.Uuid
  athleteId             String        @map("athlete_id") @db.Uuid
  exerciseId            String?       @map("exercise_id") @db.Uuid
  trainingPlanId        String?       @map("training_plan_id") @db.Uuid
  minSuccessfulSessions Int           @default(3) @map("min_successful_sessions")
  targetRpeMin          Decimal       @map("target_rpe_min") @db.Decimal(3, 1)
  targetRpeMax          Decimal       @map("target_rpe_max") @db.Decimal(3, 1)
  incrementPercent      Decimal?      @map("increment_percent") @db.Decimal(6, 3)
  incrementAbsolute     Decimal?      @map("increment_absolute") @db.Decimal(8, 3)
  maxIncrementPercent   Decimal       @map("max_increment_percent") @db.Decimal(6, 3)
  maxLoad               Decimal?      @map("max_load") @db.Decimal(8, 3)
  autoApplyAuthorized   Boolean       @default(false) @map("auto_apply_authorized")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  athlete               Athlete       @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  exercise              Exercise?     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  trainingPlan          TrainingPlan? @relation(fields: [trainingPlanId, athleteId], references: [id, athleteId], onDelete: Restrict)

  @@index([athleteId, exerciseId, trainingPlanId])
  @@map("progression_settings")
}

model ProgressionRecommendation {
  id                String                   @id @default(uuid()) @db.Uuid
  athleteId         String                   @map("athlete_id") @db.Uuid
  exerciseId        String                   @map("exercise_id") @db.Uuid
  planWeekId        String?                  @map("plan_week_id") @db.Uuid
  planExerciseId    String?                  @map("plan_exercise_id") @db.Uuid
  previousLoad      Decimal?                 @map("previous_load") @db.Decimal(8, 3)
  recommendedLoad   Decimal                  @map("recommended_load") @db.Decimal(8, 3)
  justification     String                   @db.Text
  status            RecommendationStatus     @default(PENDING)
  algorithmVersion  String                   @map("algorithm_version") @db.VarChar(40)
  effectiveSettings Json                     @map("effective_settings") @db.JsonB
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime?                @map("expires_at") @db.Timestamptz(6)
  reviewedAt        DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  athlete           Athlete                  @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  exercise          Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  planWeek          PlanWeek?                @relation(fields: [planWeekId], references: [id], onDelete: Restrict)
  planExercise      PlanExercise?            @relation(fields: [planExerciseId, exerciseId], references: [id, exerciseId], onDelete: Restrict)
  evidence          RecommendationEvidence[]
  application       ProgressionApplication?

  @@index([athleteId, status, createdAt])
  @@index([exerciseId, createdAt])
  @@index([planWeekId])
  @@map("progression_recommendations")
}

model RecommendationEvidence {
  id               String                    @id @default(uuid()) @db.Uuid
  recommendationId String                    @map("recommendation_id") @db.Uuid
  sessionId        String                    @map("session_id") @db.Uuid
  role             EvidenceRole
  associatedAt     DateTime                  @default(now()) @map("associated_at") @db.Timestamptz(6)
  recommendation   ProgressionRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  session          WorkoutSession            @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([recommendationId, sessionId])
  @@index([sessionId])
  @@map("recommendation_evidence")
}

model ProgressionApplication {
  id               String                    @id @default(uuid()) @db.Uuid
  recommendationId String                    @unique @map("recommendation_id") @db.Uuid
  appliedLoad      Decimal                   @map("applied_load") @db.Decimal(8, 3)
  origin           ApplicationOrigin
  effectiveAt      DateTime                  @map("effective_at") @db.Timestamptz(6)
  recommendation   ProgressionRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)

  @@index([effectiveAt])
  @@map("progression_applications")
}

enum ScheduledActivityStatus {
  PLANNED
  RESCHEDULED
  OMITTED
  WITHDRAWN
  REST
}
model ScheduledActivity {
  id String @id @default(uuid()) @db.Uuid
  athleteId String @map("athlete_id") @db.Uuid
  planWeekId String? @map("plan_week_id") @db.Uuid
  planDayId String? @map("plan_day_id") @db.Uuid
  originalPlanDayId String? @map("original_plan_day_id") @db.Uuid
  originalOn DateTime @map("original_on") @db.Date
  scheduledOn DateTime @map("scheduled_on") @db.Date
  timeZone String @map("time_zone") @db.VarChar(100)
  title String @db.VarChar(160)
  status ScheduledActivityStatus @default(PLANNED)
  version Int @default(0)
  creationRequestHash String? @map("creation_request_hash") @db.Char(64)
  athlete Athlete @relation(fields:[athleteId],references:[id],onDelete:Restrict)
  week PlanWeek? @relation(fields:[planWeekId],references:[id],onDelete:Restrict)
  day PlanDay? @relation("CurrentActivityDay",fields:[planDayId,planWeekId],references:[id,planWeekId],onDelete:Restrict)
  originalDay PlanDay? @relation("OriginalActivityDay",fields:[originalPlanDayId],references:[id],onDelete:Restrict)
  workouts WorkoutSession[]
  @@unique([id,athleteId])
  @@unique([id,athleteId,planWeekId,planDayId])
  @@index([athleteId,scheduledOn,status])
  @@index([planDayId,scheduledOn])
  @@map("scheduled_activities")
}
model PlanningOperation {
  id String @id @db.Uuid
  athleteId String @map("athlete_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  result Json @db.JsonB
  athlete Athlete @relation(fields:[athleteId],references:[id],onDelete:Restrict)
  plan TrainingPlan @relation(fields:[planId,athleteId],references:[id,athleteId],onDelete:Restrict)
  @@index([planId,athleteId])
  @@map("planning_operations")
}

model ExerciseAlias {
  id String @id @default(uuid()) @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid
  name String @db.VarChar(160)
  normalizedName String @default("") @map("normalized_name") @db.Text
  exercise Exercise @relation(fields:[exerciseId],references:[id],onDelete:Restrict)
  @@unique([exerciseId,normalizedName])
  @@index([normalizedName(ops:raw("gin_trgm_ops"))],type:Gin,map:"exercise_aliases_normalized_name_gin")
  @@map("exercise_aliases")
}
