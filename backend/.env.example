# Plantilla sin secretos. Configurar una base identificada y credenciales propias.
DATABASE_URL=postgresql://CHANGE_ME@localhost:5432/CHANGE_ME
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Generar dos secretos independientes de al menos 32 bytes; no reutilizar valores públicos.
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_PEPPER=
# Debe ser true en producción HTTPS.
AUTH_COOKIE_SECURE=false
# No habilitar ejecución periódica por instalar o ejecutar la aplicación.
PULSO_AUTOMATION_ENABLED=false
