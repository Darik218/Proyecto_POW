# Copia este archivo a .env y reemplaza los valores por credenciales locales.
# Mantén .env fuera de Git. No reutilices una base de datos que no identifiques.
DATABASE_URL="postgresql://<usuario>:<contraseña>@localhost:5432/proyecto_pow_dev?schema=public"

# Genera secretos independientes con un CSPRNG (mínimo 32 bytes cada uno).
# No uses valores de ejemplo en ningún entorno; nunca los subas a Git.
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_PEPPER=

# Orígenes web explícitos, separados por coma; no uses * con credenciales.
CORS_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=true

